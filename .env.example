# =============================================
# Dashboard Logística - Configurações
# Todas as variáveis usam o prefixo DASH_ (ver src/config.py).
# Copie para .env e ajuste. Nunca versione o .env.
# =============================================

# Servidor
DASH_HOST=127.0.0.1
DASH_PORT=8050
DASH_DEBUG=false

# Token Mapbox (opcional; sem ele o mapa usa Scattergeo)
# DASH_MAPBOX_TOKEN=

# Cache: diskcache | redis | memory
DASH_CACHE_TYPE=diskcache
DASH_CACHE_DIR=.cache
# DASH_REDIS_URL=redis://localhost:6379/0

# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL ; formato json | console
DASH_LOG_LEVEL=INFO
DASH_LOG_FORMAT=json

# Segurança (mínimo 16 caracteres; gere um valor aleatório em produção)
# DASH_SECRET_KEY=<valor-aleatorio-com-16+-caracteres>

# Fonte de dados: local (data/deliveries.json; sem arquivo => dados de exemplo) | api
DASH_DATA_SOURCE=local
# DASH_DATA_API_URL=https://sua-api/entregas
